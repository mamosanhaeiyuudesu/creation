NUXT_OPENAI_API_KEY=
NUXT_ANTHROPIC_API_KEY=
NUXT_MIYAKO_VECTOR_STORE_ID=

# ippon（Sketch2View）3D生成プロバイダ。未設定/mock ならマッシングGLBを手続き生成（鍵不要）
NUXT_IPPON_PROVIDER=mock
NUXT_TRIPO_API_KEY=

# life（人生のインタビュー）Google連携。Sheets/Driveへの書き込み用（fitbitとは別のOAuthクライアント）
NUXT_LIFE_GOOGLE_CLIENT_ID=
NUXT_LIFE_GOOGLE_CLIENT_SECRET=
NUXT_LIFE_GOOGLE_REDIRECT_URI=

# kikigaki（会議の録音→議事録）Google連携。Docs/Sheets/Tasks/Calendar への書き込み用
# （life とはスコープが違うので別のOAuthクライアントを発行する）
NUXT_KIKIGAKI_GOOGLE_CLIENT_ID=
NUXT_KIKIGAKI_GOOGLE_CLIENT_SECRET=
NUXT_KIKIGAKI_GOOGLE_REDIRECT_URI=