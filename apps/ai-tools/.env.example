NUXT_OPENAI_API_KEY=
NUXT_ANTHROPIC_API_KEY=
# whisper文字起こしでGeminiを選んだ場合のGoogle AI Studio鍵（未設定だとGemini選択時にエラー）
NUXT_GEMINI_API_KEY=
# vs_ で始まる OpenAI Vector Store ID（「宮古島市議会の議事録」）
NUXT_MIYAKO_VECTOR_STORE_ID=
# 各ツールの本文・OAuthトークンの暗号化（32文字以上推奨）
NUXT_ENCRYPTION_KEY=

# fitbit（Google Health API）連携
NUXT_FITBIT_CLIENT_ID=
NUXT_FITBIT_CLIENT_SECRET=
NUXT_FITBIT_REDIRECT_URI=

# kikigaki（会議の録音→議事録）Google連携。Docs/Sheets/Tasks/Calendar への書き込み用
# （fitbit とはスコープが違うので別のOAuthクライアントを発行する）
NUXT_KIKIGAKI_GOOGLE_CLIENT_ID=
NUXT_KIKIGAKI_GOOGLE_CLIENT_SECRET=
NUXT_KIKIGAKI_GOOGLE_REDIRECT_URI=

# nikki（日記）Google連携。calendar.readonly なので他と使い回さない
NUXT_NIKKI_GOOGLE_CLIENT_ID=
NUXT_NIKKI_GOOGLE_CLIENT_SECRET=
NUXT_NIKKI_GOOGLE_REDIRECT_URI=

# 手動実行API（x-admin-key ヘッダー）を守る秘密キー
NUXT_FARM_NEWS_ADMIN_KEY=
NUXT_MIYAKO_ADMIN_KEY=
