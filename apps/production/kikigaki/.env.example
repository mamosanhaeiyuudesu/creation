# キキガキ本番版のローカル用の環境変数。このファイルをコピーして .env を作る。
# 本番は wrangler.toml の [vars] と `wrangler secret put` で設定する。

# ── Firebase（公開前提の値。クライアントで使う） ──
# Firebase コンソール → プロジェクトの設定 → マイアプリ（ウェブ）に出ている値
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=

# ── モニター期間 ──
# true  = 全ユーザーが課金なしで全機能を使える（当面の運用）
# false = 契約状態を見て利用可否を判定する（有料化後）
NUXT_PUBLIC_MONITOR_MODE=true

# ── サーバー専用（クライアントには出ない） ──
NUXT_OPENAI_API_KEY=
NUXT_ANTHROPIC_API_KEY=
# 議事録・文字起こしの暗号化鍵（32文字以上）。ai-tools とは別の鍵にする
NUXT_ENCRYPTION_KEY=

# ── Stripe ──
# テストモードの値でよい。webhook の署名シークレットは `stripe listen` が表示する whsec_... を使う
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=
NUXT_STRIPE_PRICE_ID=
